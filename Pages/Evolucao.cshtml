@page
@model SiteCombustiveis.Pages.EvolucaoModel
@{
    ViewData["Title"] = "Evolução de Preço";
}

<h1>Evolução do Preço ao Longo do Tempo</h1>

<form method="get">
    <label>Posto:</label>
    <select name="idPosto">
        @foreach (var posto in Model.Postos)
        {
            <option value="@posto.IdPosto">@posto.Nome (@posto.Bairro)</option>
        }
    </select>

    <label>Combustível:</label>
    <select name="idCombustivel">
        @foreach (var combustivel in Model.Combustiveis)
        {
            <option value="@combustivel.IdCombustivel">@combustivel.Tipo</option>
        }
    </select>

    <button type="submit">Consultar</button>
</form>

<hr />

@if (Model.Resultado.Any())
{
    <table border="1" cellpadding="8">
        <thead>
            <tr>
                <th>Posto</th>
                <th>Bairro</th>
                <th>Combustível</th>
                <th>Preço (R$)</th>
                <th>Data</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Resultado)
            {
                <tr>
                    <td>@item.NomePosto</td>
                    <td>@item.Bairro</td>
                    <td>@item.TipoCombustivel</td>
                    <td>@item.Valor.ToString("F2")</td>
                    <td>@item.DataColeta.ToString("dd/MM/yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}